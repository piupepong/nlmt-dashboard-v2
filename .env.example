# ===== REQUIRED: Supabase config =====
# Copy SUPABASE_SERVICE_ROLE_KEY from Supabase dashboard (Settings > API > service_role key)
SUPABASE_URL=https://iopqamrtcuxntcojtqeu.supabase.co
SUPABASE_TABLE=energy_samples
DEVICE_ID=nlmt-main
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key

# ===== ESPHome connection =====
# Use LOCAL IP when running on same network (e.g., http://192.168.1.100:8123/events)
# Use DDNS URL when running on Render/external (e.g., https://esphome.piupepong.ddnsfree.com/events)
ESPHOME_EVENT_URL=http://192.168.1.150:8123/events

# ===== Home Assistant (optional) =====
# Only needed if you want HA sensor fallback for production counters
# HA_TOKEN: create a Long-Lived Access Token in HA profile
HA_BASE_URL=http://192.168.1.76:8123
HA_TOKEN=
HA_REFRESH_INTERVAL_MS=60000

# ===== Sample timing =====
SAMPLE_INTERVAL_MS=60000
ESPHOME_REFRESH_INTERVAL_MS=50000
STALE_EVENT_MAX_MS=120000
LAST_ROW_REFRESH_INTERVAL_MS=60000
PRODUCTION_SENSOR_MAX_AGE_MS=180000
